# ========================================
# Saliksik AI - Environment Configuration
# ========================================

# Application Settings
# --------------------
PROJECT_NAME="Saliksik AI"
VERSION=2.1.0
DEBUG=True

# Database Configuration
# ----------------------
# PostgreSQL async connection string used by the API.
# Format: postgresql+asyncpg://user:password@host:port/database
# The sync URL used by Celery and Alembic is derived automatically.
DATABASE_URL=postgresql+asyncpg://saliksik:saliksik123@localhost:5432/saliksik_ai_dev

# Security Settings
# -----------------
# REQUIRED: Generate a strong random key before deploying to production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder value below is rejected at startup: the key must be at least
# 32 characters long and contain at least 8 distinct characters.
# All workers must share the same key or JWTs signed by one worker will be
# rejected by others.
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
# 1 hour (recommended); increase for less friction
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Account Lockout
# ---------------
# Lock account after this many consecutive failed login attempts.
MAX_LOGIN_ATTEMPTS=5
# Duration (in minutes) to keep the account locked.
LOCKOUT_MINUTES=15

# Email / SMTP Settings
# ---------------------
# Leave SMTP_HOST empty to disable email sending (verification URL will be logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@saliksik.ai
SMTP_FROM_NAME="Saliksik AI"
# How long (in hours) the verification link remains valid.
EMAIL_VERIFY_EXPIRE_HOURS=24
# How long (in hours) a password reset link stays valid.
PASSWORD_RESET_EXPIRE_HOURS=1
# Base URL of your frontend application (used in verification email links).
FRONTEND_URL=http://localhost:3000

# CORS Configuration
# ------------------
# Comma-separated or JSON array of allowed origins.
# Comma-separated:  ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# JSON array:       ALLOWED_ORIGINS=["https://app.example.com","https://admin.example.com"]
# No code change needed — update this value and restart the server.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# File Upload Settings
# --------------------
MAX_FILE_SIZE_MB=10
# Maximum number of characters accepted for an authenticated manuscript.
MAX_MANUSCRIPT_CHARS=200000

# Enhancement Feature Flags
# -------------------------
ENABLE_PLAGIARISM_CHECK=True
# Similarity threshold (0.0-1.0) used when a request does not provide one.
PLAGIARISM_THRESHOLD=0.5
ENABLE_CITATION_ANALYSIS=True
ENABLE_REVIEWER_MATCHING=True
# Verify the DOIs of the references against CrossRef. Disabled by default
# because it makes the analysis depend on an outbound HTTP call.
ENABLE_DOI_VERIFICATION=False
# Contact address for the CrossRef "polite pool" (recommended in production).
CROSSREF_MAILTO=
DOI_VERIFICATION_TIMEOUT=5.0
# Maximum number of DOIs that are checked per manuscript.
DOI_VERIFICATION_MAX_DOIS=25
AUTO_DETECT_LANGUAGE=True
SUPPORTED_LANGUAGES=en,es,fr,de
DEFAULT_LANGUAGE=en

# Rate Limiting
# -------------
RATE_LIMIT_ANON=60/hour
RATE_LIMIT_USER=100/hour

# Redis Cache (Optional)
# ----------------------
# Leave empty to use in-memory cache
# Format: redis://host:port/db_number
REDIS_URL=redis://localhost:6379/0
# 1 hour in seconds
CACHE_TTL=3600

# Celery Configuration (Optional)
# --------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# AI Model Configuration
# ----------------------
# Set to True to disable heavy models for testing
AI_LIGHT_MODE=False

# Logging
# -------
LOG_LEVEL=INFO
